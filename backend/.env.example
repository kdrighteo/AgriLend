# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Configuration
# For local development:
# MONGODB_URI=mongodb://localhost:27018/agrilend

# For production (MongoDB Atlas):
# Get your connection string from MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/agrilend

# JWT Configuration
# Generate a secure random string for production
JWT_SECRET=your_secure_jwt_secret_here_change_this_in_production

# CORS Configuration
# Add your frontend domain(s) for production
# For local: http://localhost:3000
# For production: https://your-domain.com
FRONTEND_URL=http://localhost:3000
